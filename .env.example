# Snyk Automation Environment Variables Template
# Copy this file to .env and fill in your actual values

# Required Variables
SNYK_API_TOKEN=your_snyk_api_token_here
SNYK_GROUP_ID=your_snyk_group_id_here

# Optional Variables
GITHUB_TOKEN=your_github_personal_access_token_here
WEBHOOK_SECRET=your_webhook_secret_here

# Server Configuration
PORT=5000
DEBUG=false

# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual values
# 3. Never commit .env to version control
#
# To get your tokens:
# - Snyk API Token: https://app.snyk.io/account (Account Settings > API Token)
# - Snyk Group ID: https://app.snyk.io/manage/groups (Group Settings > Group ID)
# - GitHub Token: https://github.com/settings/tokens (Required scopes: repo, admin:org)
